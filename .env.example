# ===========================================
# FIG 环境变量模板 —— 复制为 .env 后填写
# .env 已在 .gitignore 中，禁止提交真实凭据
# ===========================================

# ---- 运行环境 ----
APP_ENV=development            # development / staging / production
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
# 允许的前端来源（逗号分隔）
API_CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fig
POSTGRES_USER=fig
POSTGRES_PASSWORD=change_me_in_local_env
# 异步驱动连接串（由上面字段拼装，一般不用改）
DATABASE_URL=postgresql+asyncpg://fig:change_me_in_local_env@localhost:5432/fig

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_local_env
NEO4J_DATABASE=neo4j

# ---- LLM 适配层 ----
# 业务代码不直接读这些变量，统一由 integrations/llm 读取
LLM_DEFAULT_PROVIDER=openai_compatible
LLM_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 各 provider 凭据（按需填写，未使用留空）
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_LOCAL_BASE_URL=

# ---- 图谱扩展参数（可在系统设置中覆盖）----
EXPANSION_DEFAULT_DEPTH=3
EXPANSION_MAX_DEPTH=5
EXPANSION_MAX_NODES=300
CONFIDENCE_ISOLATION_THRESHOLD=0.5
EVIDENCE_MIN_GRADE_FOR_VERIFIED=C

# ---- 采集 ----
COLLECT_RATE_LIMIT_PER_MINUTE=30
COLLECT_USER_AGENT=FIG-Collector/0.1 (+contact@example.com)

# ---- 调度 ----
SCHEDULER_ENABLED=true
PROJECTION_INTERVAL_SECONDS=300
QUALITY_SCAN_CRON=0 3 * * *

# ---- 前端（Vite 构建时注入）----
VITE_API_BASE=http://localhost:8000/api/v1
